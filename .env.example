# Copy this file to .env and fill in real values. Never commit .env.

# AQICN API token — get from https://aqicn.org/data-platform/token/
AQICN_TOKEN=your_aqicn_token_here

# Hopsworks — from https://app.hopsworks.ai
# Account Settings -> API Keys -> create with scopes: featurestore, project, job, kafka, dataset
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT=your_hopsworks_project_name_here
HOPSWORKS_HOST=c.app.hopsworks.ai

# City config — Lahore by default
CITY_NAME=Lahore
CITY_LAT=31.5497
CITY_LON=74.3436

# AQICN station identifier for the city (numeric ID or @UID string). Discovered by
# scripts/discover_stations.py; we default to Lahore US Consulate station.
AQICN_STATION=@8574
